# ============================================================
# .env.example — environment variables TEMPLATE
#
# RULES:
#   - Ye file COMMIT hoti hai (sirf naam + dummy values).
#   - Asli values wali `.env` file HAMESHA gitignored rehti hai.
#   - DB credentials KABHI browser/mobile ko nahi jate —
#     koi bhi variable jo SECRET hai wo NEXT_PUBLIC_* NAHI hoga.
#   - Naya variable add karo to pehle yahan likho, phir .env mein.
# ============================================================

# ---------- APP ----------
NEXT_PUBLIC_APP_NAME=YOUR BRAND NAME
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- DATABASE (SERVER-SIDE ONLY — SECRET) ----------
# PostgreSQL connection. Browser kabhi isko access nahi karega.
DATABASE_URL=postgresql://postgres:password@localhost:5432/task_tracker
# Pool size (server tuning)
DB_POOL_MAX=10

# ---------- AUTH (SERVER-SIDE ONLY — SECRET) ----------
# JWT signing secrets — production mein long random strings.
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- API ----------
# Mobile app is URL ko use karega (web ke liye relative base enough).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# ---------- EXTERNAL SERVICES (Phase 2+ — abhi optional) ----------
# Email/SMS provider keys — confirm hone par fill karna.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
# Push notifications (mobile Phase 5)
FIREBASE_SERVER_KEY=
