                $("#chatusername").html("<a onclick='updategroupdata("+data.chat_connection_id+","+data.groupid+",this)' id='updategroupdata' name='updategroupdata' href='javascript:void(0)'>"+data.fullname+"</a>");
				
				
				
				console.log(purl);		
				img = purl+"assets/img/no_image.png";	
					
				 $('.profile_photo').find('img').attr("src", img);
