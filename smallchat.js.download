function getuserchat(textvalue)
{
		  $(".profile_photo img").remove();
	      $(".profile_photo div").remove();
          $(".profile_photo").append(
            "<img style='height: 40px;width: 40px;border-radius: 100%' src=" +
              purl +
              "'assets/img/no_image.png'>"
          );
	var optvalue="";
	var fullname=textvalue.options[textvalue.selectedIndex].text;
	var optvalues=textvalue.options[textvalue.selectedIndex].value;
	var optvalue=$("#getuserchat").val();
	if(optvalue!='')
	{
	   $.ajax({
            type: "POST",
            url: purl+'chat/getChatRecordweb_new',
            data: {'chat_connection_id': optvalue},
            dataType: "JSON",
            success: function (data) {
			console.log(data);
			chatbox(".chatbox-popup, .chatbox-open, .chatbox-close").fadeOut();
			chatbox(".chatbox-panel").fadeIn();
			chatbox(".chatbox-panel").css({ display: "flex" });
			    //$this.find('span.notification_count').css("display", "none");
                $(".messages ul").html(data.page);
				$("#chatusername").html(fullname);
				if(data.photo!=''){

						img = purl+"upload/"+data.photo;
						}
						else
						{
						img = purl+"assets/img/no_image.png";	                        
						}
				 $('.profile_photo').find('img').attr("src", img);
                $("input[name='chat_connection_id_new']").val(data.chat_connection_id);
                $("input[name='chat_to_user_new']").val(data.chat_to_user);
                $("input[name='last_chat_id_new']").val(data.user_last_chat.id);
                $('.messages ul').animate({
                    scrollTop: $('.messages ul')[0].scrollHeight}, "slow"
                );
						
                //clearInterval(interval);
                //interval = setInterval(getrecentchat, 2000);
            }
        });
	}
	else
	{
	
$(".messages ul").html("<li>Please select Team member</li>");	
		
		
	}
 
	
}

