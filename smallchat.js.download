$(document).on('keypress', '.chat_input_new', function (e) {
if (e.which === 13) {
e.preventDefault();
sendMessage();
}
});

let isSending = false;

function sendMessage() {

    if (isSending) return;

    let message = $.trim($('.chat_input_new').val());

    if (message === '') return;

    isSending = true;

    $('.input_submit_new').prop('disabled', true);

    newChatMessage();
}

/*
$(document).on('keydown', '.chat_input_new', function (e) {
        switch (e.which) {
            case 13:
                newChatMessage();
                break;
        }
    });
	*/
	
 function htmlEncode(str) {
        return String(str).replace(/[^\w. ]/gi, function (c) {
            return '&#' + c.charCodeAt(0) + ';';
        });
    }
	function newChatMessage() {
		//var message;
        var message = htmlEncode($("#chat_input_new").val());
		$('.input_submit_new').prop('disabled', true);
        if ($.trim(message) == '') {
            return false;
        }

        var chat_connection_id = $("input[name='chat_connection_id_new']").val();
        var chat_to_user = $("input[name='chat_to_user_new']").val();
        if (chat_connection_id > 0) {

            $.ajax({
                type: "POST",
                url: purl+'chat/newMessage',
                data: {'chat_connection_id': chat_connection_id, 'message': message, 'chat_to_user': chat_to_user, 'time': date_time_temp},
                dataType: "JSON",
                beforeSend: function () {

                },
                success: function (data) {
					//alert(data.last_insert_id);
					$("input[name='last_chat_id_new']").val(data.last_insert_id);//
                    $('<li class="replies"><p>' + message + '</p> <span class="time_date_send">' + data.created_at + '</span></li>').appendTo($('.messages ul'));
                    $('.chat_input_new').val(null);
                    //$('.contact.active .preview').html('<span><?php echo 'you'; ?>: </span>' + message);
                    $('.messages ul').animate({
                        scrollTop: $('.messages ul')[0].scrollHeight}, "slow");
				  }, 
				complete: function () {
            // Allow next send
            isSending = false;
        }
				 
				
            });
        }
    };


