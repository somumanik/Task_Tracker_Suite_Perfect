function getChatsUpdates() {
		 var jsondecode=$("input[name='contactid']").val();
		 var is_groupvalue =$("input[name='contactvalue']").val();
		 console.log(jsondecode);
		
       
		
		var end_reach = false;
        var chat_connection_id = $("input[name='chat_connection_id_new']").val();
        var chat_to_user = $("input[name='chat_to_user_new']").val();
        var last_chat_id = $("input[name='last_chat_id_new']").val();
		
		if(last_chat_id>0)
		{
		
		$.ajax({
            type: "POST",
            url: purl+'chat/chatUpdate',
            data: {'chat_connection_id': chat_connection_id, 'chat_to_user': chat_to_user, 'last_chat_id': last_chat_id,'contactid':jsondecode,'contactvalue':is_groupvalue},
            dataType: "JSON",
            beforeSend: function () {
			$('.messages ul').append("");
            },
            success: function (data) { 
			
			console.log(data);
				
			   var scrollTop = $('.messages ul').scrollTop();
                if (scrollTop + $('.messages ul').innerHeight() >= $('.messages ul')[0].scrollHeight) {
                    end_reach = true;
                }
				$("input[name='last_chat_id_new']").val(data.user_last_chat.id);
				$('.messages ul').append(data.page);
                if (end_reach) {
                    $('.messages ul').animate({
                        scrollTop: $('.messages ul')[0].scrollHeight}, "slow");
				
                }
				 
            },
            error: function (jqXHR, textStatus, errorThrown) {

            },
            complete: function (data) {

            }
        });
		}
    }
	$(document).ready(function() {

  $('.chatboxzoomFix').click(function (e) {
document.querySelector('meta[name="viewport"]').content = 'width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0';
});
});  

