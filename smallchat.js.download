/*------------------------------GET GROUP DETAILS FOR UPDATE GROUP START HERE -------------------------*/

function updategroupdata(connectionid,groupid,object)
{
	$('#updategetuserchatforgroup option').remove();
	
	$("#updategroup_namemsg").empty();
	$("#updatesearchchatusersmsg").empty();
	
	var groupname=object.text;
	if(connectionid>0)
		{
		 
		 $.ajax({
            type: "POST",
            url: purl+'chat/getgroupdata',
            data: {"connectionid":connectionid},
            dataType: "JSON",
            success: function (data) 
			{
				$('#updatechatconnection_id').val(connectionid);
				$('#updategroupname').val(groupname);
				$('#groupoldname').val(groupname);
				$("#groupidvalue").val(groupid);
				
				$('#updategetuserchatforgroup').append(data.employeelist);
				chatbox(".chatbox-panel_updategroup,.chatbox-open, .chatbox-close").fadeIn();
				chatbox(".chatbox-popup,.chatbox-popup__main,.chatbox-panel").fadeOut();
				
			}
         });
		 	

}

}

